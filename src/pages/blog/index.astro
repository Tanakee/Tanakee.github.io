---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Frog3D from '../../components/Frog3D.jsx'
import Nav from '../../components/Nav.astro'
import PostCard from '../../components/PostCard.astro'
import { getPosts } from '../../lib/posts.js'

const posts = await getPosts()
---

<BaseLayout title="Blog | Tanakee" description="tanakee のブログ。作ったものや試したことを書いています。">
  <Frog3D client:only="react" className="pointer-events-none fixed inset-0 z-40 h-screen w-screen" />
  <Nav />
  <main class="min-h-screen bg-pond-bg px-6 pt-36 pb-28 md:px-12">
    <div class="mx-auto mb-16 max-w-2xl text-center">
      <p class="font-display text-xs uppercase tracking-[0.3em] text-pond-muted">Blog</p>
      <h1 class="mt-3 font-display text-3xl font-bold text-pond-text md:text-4xl">池のほとりの記録</h1>
    </div>

    {
      posts.length > 0 ? (
        <div class="mx-auto grid max-w-3xl gap-6">
          {posts.map((post) => <PostCard post={post} />)}
        </div>
      ) : (
        <p class="text-center text-pond-muted">まだ記事はありません。</p>
      )
    }
  </main>
</BaseLayout>
