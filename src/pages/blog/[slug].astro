---
import { Image } from 'astro:assets'
import { render } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import Nav from '../../components/Nav.astro'
import { formatDate, getPosts } from '../../lib/posts.js'
import { findImage, imageKey, pictureHtml } from '../../lib/r2-images.js'

// covers that haven't been uploaded yet are rendered from disk (only exists locally)
const localImages = import.meta.glob('/src/content/blog/*/*.{jpg,jpeg,png,webp,avif,gif}', { eager: true, import: 'default' })

export async function getStaticPaths() {
  const posts = await getPosts()
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }))
}

const { post } = Astro.props
const { title, description, date, updated, tags, cover, draft } = post.data
const { Content } = await render(post)

const coverEntry = cover ? findImage(post.id, cover) : null
const localCover = cover && !coverEntry ? localImages[`/src/content/blog/${imageKey(post.id, cover)}`] : null
if (cover && !coverEntry && !localCover) {
  throw new Error(`${post.id}: cover ${cover} is neither uploaded nor on disk. Run \`npm run images\`.`)
}
---

<BaseLayout title={`${title} | Tanakee`} description={description} ogImage={`/og/${post.id}.png`} ogType="article">
  <Nav />
  <main class="min-h-screen bg-pond-bg px-6 pt-36 pb-28 md:px-12">
    <article class="mx-auto max-w-2xl">
      <header class="mb-12">
        <a href="/blog/" class="text-link">← Blog</a>
        <p class="mt-8 font-display text-xs tracking-wider text-pond-muted">
          <time datetime={date.toISOString()}>{formatDate(date)}</time>
          {updated && <span class="ml-2">（更新：<time datetime={updated.toISOString()}>{formatDate(updated)}</time>）</span>}
          {draft && <span class="ml-2 rounded-full bg-pond-pink/15 px-2 py-0.5 text-pond-pink">下書き</span>}
        </p>
        <h1 class="mt-3 font-display text-3xl leading-snug font-bold text-pond-text md:text-4xl">{title}</h1>
        {
          tags.length > 0 && (
            <div class="mt-5 flex flex-wrap gap-2">
              {tags.map((tag) => (
                <span class="rounded-full bg-pond-surface px-3 py-1 text-xs font-semibold text-pond-greenDark">{tag}</span>
              ))}
            </div>
          )
        }
      </header>

      {coverEntry && <div class="mb-12" set:html={pictureHtml(coverEntry, { className: 'w-full rounded-3xl shadow-card', eager: true })} />}
      {localCover && <Image src={localCover} alt="" class="mb-12 w-full rounded-3xl shadow-card" widths={[640, 960, 1344]} sizes="(min-width: 720px) 672px, 100vw" loading="eager" />}

      <div class="prose-pond prose max-w-none">
        <Content />
      </div>
    </article>
  </main>
</BaseLayout>
