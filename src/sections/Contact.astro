---
import Pond from '../components/Pond.jsx'
---

<section id="contact" class="relative overflow-hidden bg-pond-bg px-6 py-28 md:px-12">
  <div data-reveal="0.5" style="--reveal-y: 20px; --reveal-duration: 0.6s" class="mx-auto flex max-w-xl flex-col items-center text-center">
    <p class="font-display text-xs uppercase tracking-[0.3em] text-pond-muted">Contact</p>
    <h2 class="mt-3 font-display text-3xl font-bold text-pond-text md:text-4xl">また池のほとりで</h2>
    <p class="mt-4 text-base text-pond-muted">新しいプロダクトの話やハッカソンのお誘いなど、お気軽にどうぞ。</p>
    <!-- the address is assembled in the browser so it never appears in the HTML for scrapers -->
    <div class="mt-8 flex flex-wrap justify-center gap-4" data-email={['moc.liamg', '10etak.akanat'].join('|')}>
      <a href="#contact" class="leaf-btn" data-email-link>メールで連絡する</a>
      <button type="button" class="outline-btn cursor-pointer" data-email-copy>アドレスをコピー</button>
    </div>
    <p class="mt-2 h-5 font-display text-xs text-pond-muted" aria-live="polite" data-email-status></p>
    <ul class="mt-6 flex flex-wrap justify-center gap-4">
      <li>
        <a href="https://x.com/Tanakee01" target="_blank" rel="noreferrer" class="outline-btn">X（@Tanakee01）</a>
      </li>
      <li>
        <a href="https://github.com/Tanakee" target="_blank" rel="noreferrer" class="outline-btn">GitHub</a>
      </li>
    </ul>
  </div>

  <Pond
    client:visible
    className="mx-auto mt-16 w-72 md:absolute md:bottom-12 md:left-[4%] md:mt-0 md:w-[24rem]"
    leaves={[{ x: -0.8, z: 0.2, size: 0.9, rotate: 2.5 }]}
  />

  <footer class="mt-24 text-center text-xs text-pond-muted/70">© {new Date().getFullYear()} Tanakee</footer>
</section>

<script>
  const box = document.querySelector('[data-email]')
  const [domain, user] = box.dataset.email.split('|').map((part) => [...part].reverse().join(''))
  const address = `${user}@${domain}`
  const status = document.querySelector('[data-email-status]')

  box.querySelector('[data-email-link]').href = `mailto:${address}`
  box.querySelector('[data-email-copy]').addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(address)
      status.textContent = 'コピーしました'
    } catch {
      // clipboard access can be blocked (e.g. insecure context); show it so it can be copied by hand
      status.textContent = address
    }
    clearTimeout(status.timer)
    status.timer = setTimeout(() => (status.textContent = ''), 2500)
  })
</script>
