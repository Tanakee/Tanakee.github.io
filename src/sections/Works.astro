---
import works from '../data/works.js'
import WorkCard from '../components/WorkCard.astro'
---

<section id="works" class="relative bg-pond-bg px-6 py-28 md:px-12">
  <div class="mx-auto mb-16 max-w-2xl text-center">
    <p class="font-display text-xs uppercase tracking-[0.3em] text-pond-muted">Works</p>
    <h2 class="mt-3 font-display text-3xl font-bold text-pond-text md:text-4xl">制作物たち</h2>
  </div>

  <div class="mx-auto grid max-w-5xl gap-8 sm:grid-cols-2">
    {works.map((work) => <WorkCard work={work} />)}
  </div>
</section>
