---
const links = [
  { href: '/#about', label: 'About' },
  { href: '/#works', label: 'Works' },
  { href: '/#contact', label: 'Contact' },
]
---

<nav class="fixed inset-x-0 top-0 z-50 flex items-center justify-between bg-pond-bg/80 px-6 py-5 backdrop-blur-xs md:px-12">
  <a href="/#hero" class="font-display text-lg font-bold text-pond-text">tanakee</a>
  <ul class="flex gap-7 font-display text-sm font-semibold text-pond-muted">
    {
      links.map((link) => (
        <li>
          <a href={link.href} class="transition-colors hover:text-pond-greenDark">
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
