---
import { formatDate } from '../lib/posts.js'

interface Props {
  post: import('astro:content').CollectionEntry<'blog'>
}

const { post } = Astro.props
const { title, description, date, tags, draft } = post.data
---

<a
  href={`/blog/${post.id}/`}
  data-reveal="0.3"
  style="--reveal-y: 24px; --reveal-duration: 0.5s"
  class="group block rounded-3xl border border-pond-line bg-pond-surface p-7 shadow-card transition-shadow duration-300 hover:shadow-soft"
>
  <p class="font-display text-[11px] tracking-wider text-pond-muted">
    <time datetime={date.toISOString()}>{formatDate(date)}</time>
    {draft && <span class="ml-2 rounded-full bg-pond-pink/15 px-2 py-0.5 text-pond-pink">下書き</span>}
  </p>
  <h3 class="mt-3 font-display text-xl font-bold text-pond-text transition-colors group-hover:text-pond-greenDark">
    {title}
  </h3>
  <p class="mt-3 text-sm leading-relaxed text-pond-muted">{description}</p>
  {
    tags.length > 0 && (
      <div class="mt-4 flex flex-wrap gap-2">
        {tags.map((tag) => (
          <span class="rounded-full bg-pond-bg px-3 py-1 text-xs font-semibold text-pond-greenDark">{tag}</span>
        ))}
      </div>
    )
  }
</a>
