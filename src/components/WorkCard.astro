---
interface Props {
  work: {
    title: string
    event: string
    award?: string
    summary: string
    tags: string[]
    repoUrl: string
    demoUrl?: string
    refUrl?: string
  }
}

const { work } = Astro.props
---

<!-- the card spans 6 rows of the parent grid via subgrid: header, title, award, summary, tags, links -->
<div
  data-reveal="0.3"
  data-tilt
  style="--reveal-y: 24px; --reveal-duration: 0.5s"
  class="row-span-6 grid grid-rows-subgrid gap-y-0 rounded-3xl border border-pond-line bg-pond-surface p-7 shadow-card transition-shadow duration-300 hover:shadow-soft"
>
  <div class="flex items-start justify-between">
    <svg width="28" height="28" viewBox="0 0 32 32" fill="none" aria-hidden="true">
      <path d="M16 4C24 4 28 12 28 20C28 25 22.5 28 16 28C9.5 28 4 25 4 20C4 12 8 4 16 4Z" fill="#dcecd5" />
      <path d="M16 6V27" stroke="#8fc08a" stroke-width="1.4" stroke-linecap="round" />
    </svg>
    <p class="text-right font-display text-[11px] tracking-wider text-pond-muted">{work.event}</p>
  </div>

  <h3 class="mt-4 font-display text-xl font-bold text-pond-text">{work.title}</h3>
  <!-- always rendered so every card keeps the same rows and they line up across the grid -->
  <p class="mt-1 font-display text-xs font-bold text-pond-pink">{work.award && `受賞：${work.award}`}</p>
  <p class="mt-3 text-sm leading-relaxed text-pond-muted">{work.summary}</p>

  <div class="mt-4 flex flex-wrap content-start gap-2">
    {
      work.tags.map((tag) => (
        <span class="rounded-full bg-pond-bg px-3 py-1 text-xs font-semibold text-pond-greenDark">{tag}</span>
      ))
    }
  </div>

  <div class="mt-5 flex flex-wrap gap-4 border-t border-pond-line pt-4">
    <a href={work.repoUrl} target="_blank" rel="noreferrer" class="text-link">GitHub</a>
    {work.demoUrl && <a href={work.demoUrl} target="_blank" rel="noreferrer" class="text-link">Demo</a>}
    {work.refUrl && <a href={work.refUrl} target="_blank" rel="noreferrer" class="text-link">詳細資料</a>}
  </div>
</div>

<script>
  import '../scripts/tilt.js'
</script>
